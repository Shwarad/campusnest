# ─────────────────────────────────────────────────────────────────────────────
# CampusNest — Server Environment Variables
# Copy this file to server/.env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production | test

# ── Database ──────────────────────────────────────────────────────────────────
#
# LOCAL DEV (SQLite — zero setup, just uncomment and change schema provider):
#   1. In server/prisma/schema.prisma set  provider = "sqlite"
#   2. Use the line below:
# DATABASE_URL=file:./campusnest.db
#
# PRODUCTION (PostgreSQL via Neon — free tier):
#   1. Sign up at https://neon.tech  →  create project  →  copy "Connection string"
#   2. In server/prisma/schema.prisma set  provider = "postgresql"  (already done)
#   3. Use the line below:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/campusnest?sslmode=require

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Google OAuth ───────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 3. Application type: Web application
# 4. Add Authorised JavaScript origins: http://localhost:5173 (dev) + your Vercel URL (prod)
# 5. Copy the Client ID below (keep Client Secret — it is NOT needed on the server here)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── SMS OTP via Twilio ─────────────────────────────────────────────────────────
# 1. Sign up at https://twilio.com → get a free trial number
# 2. Console Dashboard → Account SID + Auth Token
# If left blank, OTPs are printed to the server console (dev mode only)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx      # Twilio sender number (E.164 format)

# ── Email OTP via SMTP ─────────────────────────────────────────────────────────
# Works with Gmail, Outlook, Mailgun, Resend, etc.
# Gmail example: use an App Password (not your account password)
#   https://myaccount.google.com → Security → App Passwords
# Resend (recommended): https://resend.com  →  SMTP credentials
# If left blank, OTPs are printed to the server console (dev mode only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CampusNest <you@gmail.com>

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:
CLIENT_URL=http://localhost:5173
# Production (add your Vercel frontend URL):
# CLIENT_URL=https://campusnest.vercel.app,http://localhost:5173

# ── IBM watsonx.ai / Granite AI ────────────────────────────────────────────────
# Sign up at https://cloud.ibm.com  →  create watsonx.ai project  →  copy credentials
#
# IBM Cloud API key (from IAM → API keys):
IBM_WATSONX_API_KEY=
#
# watsonx.ai project ID (from your project settings):
IBM_WATSONX_PROJECT_ID=
#
# Regional base URL — choose your region's endpoint:
#   US South:  https://us-south.ml.cloud.ibm.com
#   EU DE:     https://eu-de.ml.cloud.ibm.com
#   JP TOK:    https://jp-tok.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
#
# Granite model ID — check available models in your region/account:
IBM_GRANITE_MODEL_ID=ibm/granite-13b-chat-v2
#
# Granite embedding model:
IBM_GRANITE_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr
#
# watsonx.ai API version:
IBM_WATSONX_API_VERSION=2024-05-31
#
# AI request timeout in milliseconds (default: 20 seconds):
AI_REQUEST_TIMEOUT_MS=20000
#
# Set to false to disable all AI features:
AI_FEATURES_ENABLED=true
#
# Set to true to run in offline mock mode (no IBM credentials needed):
AI_MOCK_MODE=false
