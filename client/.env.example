# ─────────────────────────────────────────────────────────────────────────────
# CampusNest — Client (Frontend) Environment Variables
# Copy this file to client/.env and fill in the values.
# In Vercel, set these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URL ───────────────────────────────────────────────────────────────────
#
# Leave EMPTY (or omit) when the frontend and backend are deployed together
# under one Vercel project (same domain). Vercel rewrites /api/* to the
# serverless function automatically.
#
# Set this ONLY when frontend and backend are on SEPARATE Vercel projects
# (or on Railway / Render for the backend):
# VITE_API_URL=https://campusnest-api.vercel.app
#
# LOCAL DEV — leave blank; the Vite dev server proxies /api → localhost:5000
VITE_API_URL=
