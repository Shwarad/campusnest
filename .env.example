# ─────────────────────────────────────────────────────────────────────────────
# CampusNest — Root .env.example
#
# This file documents ALL environment variables used by the project.
# ├─ server/.env.example  — server-only vars (copy → server/.env for local dev)
# └─ client/.env.example  — frontend vars    (copy → client/.env for local dev)
#
# On Vercel, set these under:
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# ════════════════════════
#  SERVER / BACKEND VARS
# ════════════════════════

PORT=5000
NODE_ENV=production

# PostgreSQL connection string (Neon free tier recommended)
# Get from: https://neon.tech → Project → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-yyy.us-east-2.aws.neon.tech/campusnest?sslmode=require

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-64-random-bytes-hex
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins allowed by CORS
# Set to your Vercel frontend URL in production
CLIENT_URL=https://campusnest.vercel.app

# ════════════════════════
#  CLIENT / FRONTEND VARS
#  (prefix: VITE_)
# ════════════════════════

# Leave blank when frontend + backend share one Vercel project (same domain).
# Set to the backend URL only when they are SEPARATE Vercel projects.
VITE_API_URL=
